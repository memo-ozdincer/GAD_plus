# Git-built application image. Immutable experiment data is mounted read-only
# from Cloud Storage at runtime, so source control contains no raw trajectories.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src

WORKDIR /app
# Plotly 6.x currently ships plotly.js 3.x, whose browser bundle has caused
# blank dashboard panels in this otherwise plain-JS viewer.  Keep the proven
# 5.x / plotly.js 2.x renderer pinned until the 3.x interaction regression is
# resolved upstream.
RUN pip install --no-cache-dir Flask duckdb numpy pyarrow 'plotly==5.24.1'
COPY src /app/src
COPY scripts/serve_t1x_trajectory_explorer.py /app/serve_t1x_trajectory_explorer.py

EXPOSE 8080
CMD ["python", "/app/serve_t1x_trajectory_explorer.py"]
